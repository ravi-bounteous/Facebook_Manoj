ARC_DEV_PORT=8004
ARC_WEB_PORT=3004
# set a strong password before running docker-compose
POSTGRES_PASSWORD=

# Backend required settings (backend/src/config.ts fails fast if these are unset)
# NOTE: backend/src/config.ts loads dotenv from backend/.env, not this repo-root file.
# Copy these variables into backend/.env (not just here) for the backend to pick them up.
DATABASE_URL=postgres://postgres:changeme@localhost:5433/taskmanager_test
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-with-a-generated-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-generated-random-secret
